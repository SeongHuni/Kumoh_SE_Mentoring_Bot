# 비밀
.secrets/
embedding-api-key.txt
.env
.env.local
frontend/.env.local

# 의존성
node_modules/
frontend/node_modules/

# 빌드 산출물
frontend/.next/
frontend/out/
dist/

# 런타임 데이터
# chroma-data/ 는 챗봇이 바로 동작하도록 git에 포함한다 (아래 참고).
chroma-data-python-backup/
outputs/.embedding_cache/

# 대용량 중간 산출물 (outputs/chunking_experiments/<exp>/chunks.jsonl 은 추적)
outputs/chunking_experiments/**/embeddings.jsonl
outputs/chunking_experiments/**/embedding_progress.json
outputs/chunking_experiments/**/sentence_embeddings.jsonl

# 로그
*.log
*.log.err

# 파이썬
__pycache__/
*.pyc

# 벡터 DB 압축본 — chroma-data/ 를 직접 git에 넣으므로 zip은 중복이라 안 넣는다.
chroma-data.zip

# 빌드 산출물 / 임시 백업
frontend/tsconfig.tsbuildinfo
outputs/frontend-src-backup/

# 코퍼스 백업 (적재 전 스냅샷). 재생성 가능하고 1.8MB 라 매번 통째로 바뀐다.
outputs/corpus-backup-*.json

# 보관용 폴더는 저장소 밖(../\_archive/)에 둔다.
# 옛 공유 번들(sw-rag-share), 크롤 원본 3종, zip 중복본이 들어 있다.
# 챗봇 동작에는 필요 없고, 원본 대조가 필요할 때만 로컬에서 본다.
_archive/

# Chroma SQLite 백업 (적재 전 스냅샷). 26MB 바이너리라 저장소에 넣지 않는다.
outputs/chroma-sqlite-backup-*.bak

# 청중 대화 기록 — 개인 질문 내용이라 git 에 올리지 않는다.
data/conversations/

# 접속 QR — 그날그날 IP를 인코딩하므로 git 에 올리지 않는다 (scripts/generate_qr.py 로 로컬에서 생성).
docs/챗봇_접속_QR.png
